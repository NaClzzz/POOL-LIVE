# PostgreSQL
POSTGRES_USER=pooluser
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=poollive

# 应用连接数据库（服务名 postgres 由 Docker DNS 解析）
DATABASE_URL=postgresql://pooluser:change-me-in-production@postgres:5432/poollive

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-string
BETTER_AUTH_URL=http://localhost:3000

# 前端
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Socket
SOCKET_PORT=3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# 网易云 API（通过 host.docker.internal 访问宿主机上的 api-enhanced）
MUSIC_API_BASE_URL=http://host.docker.internal:3002

# AI
DASHSCOPE_API_KEY=sk-your-api-key
DASHSCOPE_BASE_URL=https://your-region.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4-flash