FROM node:20-slim

ARG PNPM_VERSION=10.33.0
WORKDIR /app

RUN npm install -g pnpm@${PNPM_VERSION}

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.json ./
COPY src ./src
COPY socket-server ./socket-server

RUN pnpm install --frozen-lockfile

EXPOSE 3001

CMD ["pnpm", "start:socket"]